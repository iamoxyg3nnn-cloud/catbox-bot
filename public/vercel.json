{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/admin", "destination": "https://api.mew-pocket.de5.net/admin", "permanent": false },
    { "source": "/admin.html", "destination": "https://api.mew-pocket.de5.net/admin", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.mew-pocket.de5.net/api/:path*" },
    { "source": "/user/api.php", "destination": "https://api.mew-pocket.de5.net/user/api.php" },
    { "source": "/user/dologin.php", "destination": "https://api.mew-pocket.de5.net/user/dologin.php" },
    { "source": "/user/doregister.php", "destination": "https://api.mew-pocket.de5.net/user/doregister.php" },
    { "source": "/user/reset_password.php", "destination": "https://api.mew-pocket.de5.net/user/reset_password.php" },
    { "source": "/user/logout.php", "destination": "https://api.mew-pocket.de5.net/user/logout.php" },
    { "source": "/litterbox/api.php", "destination": "https://api.mew-pocket.de5.net/litterbox/api.php" },
    { "source": "/files/:path*", "destination": "https://api.mew-pocket.de5.net/files/:path*" },
    { "source": "/i/:path*", "destination": "https://api.mew-pocket.de5.net/i/:path*" },
    { "source": "/do_contact.php", "destination": "https://api.mew-pocket.de5.net/do_contact.php" },
    { "source": "/ops", "destination": "https://api.mew-pocket.de5.net/ops" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
