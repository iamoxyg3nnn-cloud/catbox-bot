# Copy to .env and fill in. NEVER commit real tokens.

PORT=3000
PUBLIC_BASE_URL=https://api.catbox.example.com
TRUST_PROXY=1
DATA_DIR=./data

# Per-file ceiling. Raw bytes or 20mb / 20MiB / 512kb etc.
MAX_FILE_SIZE=20mb

# File delivery: proxy (default, keeps our own domain in the address bar) or
# redirect (legacy 302 to the storage CDN). Bytes stay in Discord either way.
FILE_DELIVERY=proxy

# --- Discord storage -------------------------------------------------------
# For a single bot (handy for the first live verification):
# DISCORD_BOT_ID=primary
# DISCORD_BOT_TOKEN=your-bot-token
# DISCORD_CHANNEL_ID=your-channel-id

# For the 20-bot fleet (preferred). JSON array; one dedicated channel per bot.
# DISCORD_BOTS=[{"id":"bot-01","token":"...","channelId":"..."},{"id":"bot-02","token":"...","channelId":"..."}]

# Tests only. Never set to mock in production.
# DISCORD_TRANSPORT=mock

# Optional tuning
# DISCORD_TIMEOUT_MS=120000
# DISCORD_MAX_RETRIES=3
# DISCORD_USER_AGENT=DiscordBot (catbox-clone, 1.0)
