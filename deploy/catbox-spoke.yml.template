name: Catbox Spoke __NODE_ID__

# One Discord bot per repository. This spoke runs with NODE_MODE=node, holds a
# single bot token, and exposes itself to the hub through a per-session
# Cloudflare quick tunnel. It does NOT run the admin console, job runner,
# metadata mirror or expiry purge (all single-writer). Each run queues its own
# successor so the spoke stays online by chaining, never by a cron trigger.

on:
  workflow_dispatch:
    inputs:
      triggered_by:
        description: 'session-chain:<n> (automatic) | blank if manual'
        required: false
        default: ''

concurrency:
  group: catbox-spoke-session
  cancel-in-progress: false

permissions:
  contents: read
  actions: write

jobs:
  spoke:
    name: catbox-spoke-__NODE_ID__
    runs-on: windows-latest
    timeout-minutes: 360
    env:
      GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Queue the next session (early insurance)
        if: always()
        shell: pwsh
        env:
          TRIGGERED_BY: ${{ inputs.triggered_by }}
          CHAIN_REF: ${{ github.event.repository.default_branch || github.ref_name }}
        run: |
          $n = 0
          if ($env:TRIGGERED_BY -match '^session-chain:(\d{1,9})$') { $n = [int]$Matches[1] }
          $maxRetries = 5
          if (($n + 1) -gt $maxRetries) {
            Write-Host "Retry budget spent ($n/$maxRetries) - not queueing."
            exit 0
          }
          $body = @{
            ref = $env:CHAIN_REF
            inputs = @{ triggered_by = "session-chain:$($n + 1)" }
          } | ConvertTo-Json -Compress -Depth 5
          $uri = "$env:GITHUB_API_URL/repos/$env:GITHUB_REPOSITORY/actions/workflows/catbox-spoke.yml/dispatches"
          $headers = @{
            Authorization = "Bearer $env:GH_TOKEN"
            Accept = 'application/vnd.github+json'
            'X-GitHub-Api-Version' = '2022-11-28'
          }
          foreach ($attempt in 1..3) {
            try {
              Invoke-RestMethod -Method Post -Uri $uri -Headers $headers -ContentType 'application/json' -Body $body | Out-Null
              Write-Host "Successor queued (retry $($n + 1)/$maxRetries)."
              exit 0
            } catch {
              Write-Warning "Dispatch attempt $attempt failed: $($_.Exception.Message)"
              if ($attempt -lt 3) { Start-Sleep -Seconds 15 }
            }
          }
          Write-Error 'Could not queue the next session from the insurance step.'

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: npm

      - name: Install dependencies
        run: npm ci

      - name: 'Prepare local D: staging'
        shell: pwsh
        run: |
          # Transient bytes only, deleted once Discord confirms the attachment.
          New-Item -ItemType Directory -Force -Path 'D:\catbox_staging' | Out-Null
          Write-Host "Spoke staging ready: D:\catbox_staging"

      - name: Write runtime configuration
        shell: pwsh
        env:
          PUBLIC_BASE_URL: ${{ secrets.PUBLIC_BASE_URL }}
          CONTROL_PLANE_URL: ${{ secrets.CONTROL_PLANE_URL }}
          DISCORD_BOT_TOKEN: ${{ secrets.DISCORD_BOT_TOKEN }}
          DISCORD_CHANNEL_ID: ${{ secrets.DISCORD_CHANNEL_ID }}
          SUPABASE_URL: ${{ secrets.SUPABASE_URL }}
          SUPABASE_SERVICE_ROLE_KEY: ${{ secrets.SUPABASE_SERVICE_ROLE_KEY }}
          NODE_UPLOAD_SECRET: ${{ secrets.NODE_UPLOAD_SECRET }}
        run: |
          # This spoke owns exactly one bot. PUBLIC_BASE_URL is the HUB origin so
          # generated file links point at the public API, not this tunnel.
          $bots = @(@{ id = '__NODE_ID__'; token = $env:DISCORD_BOT_TOKEN; channelId = $env:DISCORD_CHANNEL_ID })
          $botsJson = $bots | ConvertTo-Json -Compress -Depth 5

          @"
          PORT=3000
          PUBLIC_BASE_URL=$env:PUBLIC_BASE_URL
          CONTROL_PLANE_URL=$env:CONTROL_PLANE_URL
          NODE_MODE=node
          NODE_ID=__NODE_ID__
          TRUST_PROXY=1
          DATA_DIR=./data
          STAGING_DIR=D:\catbox_staging
          MAX_FILE_SIZE=20mb
          FILE_DELIVERY=proxy
          DISCORD_BOT_ID=__NODE_ID__
          DISCORD_BOTS=$botsJson
          DISCORD_CHANNEL_ID=$env:DISCORD_CHANNEL_ID
          SUPABASE_URL=$env:SUPABASE_URL
          SUPABASE_SERVICE_ROLE_KEY=$env:SUPABASE_SERVICE_ROLE_KEY
          NODE_UPLOAD_SECRET=$env:NODE_UPLOAD_SECRET
          "@ | Set-Content -Path .env -Encoding utf8

          "DISCORD_BOTS=$botsJson" | Out-File -FilePath $env:GITHUB_ENV -Append
          Write-Host 'Runtime configuration written for one Discord bot (token masked in logs).'

      - name: Require durable metadata config
        shell: pwsh
        env:
          PUBLIC_BASE_URL: ${{ secrets.PUBLIC_BASE_URL }}
          CONTROL_PLANE_URL: ${{ secrets.CONTROL_PLANE_URL }}
          DISCORD_BOT_TOKEN: ${{ secrets.DISCORD_BOT_TOKEN }}
          DISCORD_CHANNEL_ID: ${{ secrets.DISCORD_CHANNEL_ID }}
          SUPABASE_URL: ${{ secrets.SUPABASE_URL }}
          SUPABASE_SERVICE_ROLE_KEY: ${{ secrets.SUPABASE_SERVICE_ROLE_KEY }}
          NODE_UPLOAD_SECRET: ${{ secrets.NODE_UPLOAD_SECRET }}
        run: |
          $missing = @()
          foreach ($name in 'PUBLIC_BASE_URL','CONTROL_PLANE_URL','DISCORD_BOT_TOKEN','DISCORD_CHANNEL_ID','SUPABASE_URL','SUPABASE_SERVICE_ROLE_KEY','NODE_UPLOAD_SECRET') {
            if ([string]::IsNullOrWhiteSpace([Environment]::GetEnvironmentVariable($name))) {
              Write-Error "::error::$name is empty - refusing to start on an ephemeral runner"
              $missing += $name
            }
          }
          if ($missing.Count -gt 0) { exit 1 }
          Write-Host 'Durable metadata configuration present.'

      - name: Install cloudflared
        shell: pwsh
        run: |
          $dest = "$env:RUNNER_TEMP\cloudflared.exe"
          Invoke-WebRequest -Uri 'https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-windows-amd64.exe' `
            -OutFile $dest -UseBasicParsing -TimeoutSec 180
          & $dest --version

      - name: Start spoke and keep alive
        shell: pwsh
        env:
          PUBLIC_BASE_URL: ${{ secrets.PUBLIC_BASE_URL }}
          CONTROL_PLANE_URL: ${{ secrets.CONTROL_PLANE_URL }}
          DISCORD_CHANNEL_ID: ${{ secrets.DISCORD_CHANNEL_ID }}
          SUPABASE_URL: ${{ secrets.SUPABASE_URL }}
          SUPABASE_SERVICE_ROLE_KEY: ${{ secrets.SUPABASE_SERVICE_ROLE_KEY }}
          NODE_UPLOAD_SECRET: ${{ secrets.NODE_UPLOAD_SECRET }}
        run: |
          # The app reads process.env directly (no dotenv loader). Set the
          # non-secret values here; secrets arrive via this step's env block.
          $env:PORT = '3000'
          $env:NODE_MODE = 'node'
          $env:NODE_ID = '__NODE_ID__'
          $env:STAGING_DIR = 'D:\catbox_staging'
          $env:DATA_DIR = '.\data'
          $env:FILE_DELIVERY = 'proxy'
          $env:DISCORD_BOT_ID = '__NODE_ID__'
          $env:MAX_FILE_SIZE = '20mb'
          $env:TRUST_PROXY = '1'

          $tunnelLog = "$env:RUNNER_TEMP\tunnel.log"
          $tunnelErr = "$env:RUNNER_TEMP\tunnel.err"
          $serverLog = "$env:RUNNER_TEMP\server.log"
          $serverErr = "$env:RUNNER_TEMP\server.err"
          Set-Content -Path $tunnelLog -Value ''
          Set-Content -Path $tunnelErr -Value ''
          Set-Content -Path $serverLog -Value ''
          Set-Content -Path $serverErr -Value ''

          $cloudflared = "$env:RUNNER_TEMP\cloudflared.exe"

          # A quick tunnel needs no named-tunnel token; its URL is random and
          # valid only for this session, so the hub learns it via heartbeat.
          $tunnelProc = Start-Process -FilePath $cloudflared `
            -ArgumentList @('tunnel', '--no-autoupdate', '--url', 'http://localhost:3000') `
            -PassThru -RedirectStandardOutput $tunnelLog -RedirectStandardError $tunnelErr

          $url = ''
          foreach ($i in 1..60) {
            if ($tunnelProc.HasExited) {
              Write-Error '::error::cloudflared exited before publishing a URL'
              Get-Content $tunnelLog, $tunnelErr -Tail 80 -ErrorAction SilentlyContinue
              exit 1
            }
            $text = ((Get-Content $tunnelLog, $tunnelErr -Raw -ErrorAction SilentlyContinue) -join "`n")
            $match = [regex]::Match($text, 'https://[a-z0-9][a-z0-9-]*\.trycloudflare\.com')
            if ($match.Success) { $url = $match.Value; break }
            Start-Sleep -Seconds 2
          }
          if (-not $url) {
            Write-Error '::error::No quick tunnel URL appeared within 120s'
            Get-Content $tunnelLog, $tunnelErr -Tail 80 -ErrorAction SilentlyContinue
            exit 1
          }
          $env:NODE_PUBLIC_URL = $url

          $nodeExe = (Get-Command node).Source
          $serverProc = Start-Process -FilePath $nodeExe -ArgumentList 'server.js' `
            -WorkingDirectory $env:GITHUB_WORKSPACE -PassThru `
            -RedirectStandardOutput $serverLog -RedirectStandardError $serverErr

          try {
            # Readiness: local app AND registration in the hub's node registry.
            $ready = $false
            $deadline = (Get-Date).AddSeconds(180)
            while ((Get-Date) -lt $deadline) {
              if ($serverProc.HasExited) {
                Write-Error '::error::Spoke exited before becoming ready'
                Get-Content $serverLog, $serverErr -Tail 100 -ErrorAction SilentlyContinue
                exit 1
              }
              if ($tunnelProc.HasExited) {
                Write-Error '::error::cloudflared exited before becoming ready'
                Get-Content $tunnelLog, $tunnelErr -Tail 100 -ErrorAction SilentlyContinue
                exit 1
              }
              try {
                $local = Invoke-WebRequest -Uri 'http://localhost:3000/api/config' -UseBasicParsing -TimeoutSec 5 -SkipHttpErrorCheck
                if ([int]$local.StatusCode -eq 200) {
                  $nodes = Invoke-RestMethod -Uri "$env:CONTROL_PLANE_URL/api/nodes" -TimeoutSec 10
                  $found = @($nodes | Where-Object { $_.id -eq '__NODE_ID__' -and $_.status -eq 'up' })
                  if ($found.Count -gt 0) { $ready = $true; break }
                }
              } catch { } # Not ready yet.
              Start-Sleep -Seconds 5
            }
            if (-not $ready) {
              Write-Error '::error::Spoke did not register with the hub within 180s'
              Get-Content $serverLog, $serverErr -Tail 100 -ErrorAction SilentlyContinue
              Get-Content $tunnelLog, $tunnelErr -Tail 100 -ErrorAction SilentlyContinue
              exit 1
            }

            Write-Host '======================================='
            Write-Host "       CATBOX SPOKE __NODE_ID__ READY"
            Write-Host '======================================='
            Write-Host "  Session : #$env:GITHUB_RUN_NUMBER"
            Write-Host "  Tunnel  : $url"
            Write-Host '======================================='

            # Hold the session open. 330 min, below the 360 min job cap so a
            # healthy run always reaches SESSION_COMPLETE.
            $end = (Get-Date).AddMinutes(330)
            $serverLines = 0
            $tunnelLines = 0
            while ((Get-Date) -lt $end) {
              if ($serverProc.HasExited) {
                Write-Error "::error::Spoke exited unexpectedly (exit code $($serverProc.ExitCode))"
                Get-Content $serverLog, $serverErr -Tail 200 -ErrorAction SilentlyContinue
                exit 1
              }
              if ($tunnelProc.HasExited) {
                Write-Error "::error::cloudflared exited unexpectedly (exit code $($tunnelProc.ExitCode))"
                Get-Content $tunnelLog, $tunnelErr -Tail 200 -ErrorAction SilentlyContinue
                exit 1
              }
              $all = @(Get-Content $serverLog -ErrorAction SilentlyContinue)
              if ($all.Count -gt $serverLines) {
                $all[$serverLines..($all.Count - 1)] | ForEach-Object { Write-Host $_ }
                $serverLines = $all.Count
              }
              $all = @(Get-Content $tunnelLog -ErrorAction SilentlyContinue)
              if ($all.Count -gt $tunnelLines) {
                $all[$tunnelLines..($all.Count - 1)] | ForEach-Object { Write-Host $_ }
                $tunnelLines = $all.Count
              }
              $code = 0
              try {
                $probe = Invoke-WebRequest -Uri 'http://localhost:3000/api/config' -UseBasicParsing -TimeoutSec 10 -SkipHttpErrorCheck
                $code = [int]$probe.StatusCode
              } catch { }
              Write-Host "[$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')] Spoke __NODE_ID__ alive (PID $($serverProc.Id)) - HTTP $code"
              Start-Sleep -Seconds 30
            }
            'SESSION_COMPLETE=true' | Out-File -FilePath $env:GITHUB_ENV -Append
          } finally {
            Stop-Process -Id $tunnelProc.Id -Force -ErrorAction SilentlyContinue
            Stop-Process -Id $serverProc.Id -Force -ErrorAction SilentlyContinue
          }

      - name: Queue the next session (session end)
        if: always()
        shell: pwsh
        env:
          TRIGGERED_BY: ${{ inputs.triggered_by }}
          CHAIN_REF: ${{ github.event.repository.default_branch || github.ref_name }}
          ALERT_WEBHOOK_URL: ${{ secrets.ALERT_WEBHOOK_URL }}
        run: |
          $n = 0
          if ($env:TRIGGERED_BY -match '^session-chain:(\d{1,9})$') { $n = [int]$Matches[1] }
          $maxRetries = 5
          $next = $n + 1
          if ($env:SESSION_COMPLETE -eq 'true') { $next = 0 }
          $stopReason = ''
          if ($next -gt $maxRetries) {
            $stopReason = "$n sessions in a row ended early or never started"
          } else {
            $body = @{
              ref = $env:CHAIN_REF
              inputs = @{ triggered_by = "session-chain:$next" }
            } | ConvertTo-Json -Compress -Depth 5
            $uri = "$env:GITHUB_API_URL/repos/$env:GITHUB_REPOSITORY/actions/workflows/catbox-spoke.yml/dispatches"
            $headers = @{
              Authorization = "Bearer $env:GH_TOKEN"
              Accept = 'application/vnd.github+json'
              'X-GitHub-Api-Version' = '2022-11-28'
            }
            $queued = $false
            foreach ($attempt in 1..3) {
              try {
                Invoke-RestMethod -Method Post -Uri $uri -Headers $headers -ContentType 'application/json' -Body $body | Out-Null
                $queued = $true
                break
              } catch {
                Write-Warning "Dispatch attempt $attempt failed: $($_.Exception.Message)"
                if ($attempt -lt 3) { Start-Sleep -Seconds 15 }
              }
            }
            if ($queued) {
              Write-Host "Successor queued (retry $next/$maxRetries)."
              exit 0
            }
            $stopReason = 'GitHub refused the dispatch (see warnings above)'
          }
          Write-Error "::error::Spoke session chain stopped: $stopReason"
          if (-not [string]::IsNullOrWhiteSpace($env:ALERT_WEBHOOK_URL)) {
            $content = ":warning: **catbox-bot-__NODE_ID__** spoke chain stopped: $stopReason"
            $payload = @{ content = $content } | ConvertTo-Json -Compress
            try {
              Invoke-RestMethod -Method Post -Uri $env:ALERT_WEBHOOK_URL -ContentType 'application/json' -Body $payload | Out-Null
            } catch { Write-Warning 'Discord alert failed.' }
          }
